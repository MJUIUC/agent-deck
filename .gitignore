# Rust
target/
**/*.rs.bk
Cargo.lock

# SQLite database files
*.db
*.db-shm
*.db-wal
data/

# Environment files
.env
server/.env

# Build artifacts — ignore hashed JS/CSS bundles (new hash every build, causes
# churn in git history) but keep index.html tracked so the server can serve the
# app without a build step in CI/dev.
server/public/assets/
server/public/node_modules/

# Node / web
web/node_modules/
web/dist/
web/.vite/

# React Native / mobile
mobile/BotRelayApp/node_modules/
mobile/BotRelayApp/android/build/
mobile/BotRelayApp/android/.gradle/
mobile/BotRelayApp/android/app/build/
mobile/BotRelayApp/android/local.properties
mobile/BotRelayApp/ios/build/
mobile/BotRelayApp/ios/Pods/
mobile/BotRelayApp/.expo/

# Machine identity (never commit — see docs/AGENT_WORKFLOW.md §15)
.agent-machine

# macOS
.DS_Store
**/.DS_Store

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
logs/

# SQLx offline query cache (committed intentionally — see PLAN.md §9.4)
# .sqlx/

# Firebase
config/firebase-service-account.json

# Avatars uploaded at runtime
data/avatars/

# Vendor — copilot-api is a git submodule, not ignored
# vendor/copilot-api is tracked via .gitmodules
#

