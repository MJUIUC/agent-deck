# agent-deck server environment variables
# Copy this file to .env and fill in the values.

# Server port (default: 7474)
PORT=7474

# SQLite database URL
# The data/ directory will be created automatically on first run.
DATABASE_URL=sqlite:~/.agent-deck/.database/agent-deck.db  # path used by the running server; sqlx CLI tools need this to stay in sync

# Log level: trace | debug | info | warn | error
RUST_LOG=info

# Path to Firebase service account JSON for FCM push notifications.
# Only required if you want push notifications on the Android app.
# Leave commented out to disable push notifications.
# FCM_SERVICE_ACCOUNT_JSON=./config/firebase-service-account.json

# Directory to serve the React SPA static files from.
# After running `npm run build` in the web/ directory, files land in server/public/.
# Defaults to ./public — only change this if you've moved the build output.
# PUBLIC_DIR=./public
