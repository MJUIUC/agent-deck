# ── agent-deck server environment variables ───────────────────────────────────
#
# Copy this file to .env and fill in the values for your local setup.
# Loaded automatically by dotenvy at startup when running `cargo run`.
#
# Production deployments (via install.sh) do not use this file — env vars
# are written directly into the run script at deploy time.

# ── Local development ─────────────────────────────────────────────────────────

# Absolute path to the compiled React frontend.
# In development, point this at the web build output directory so the Rust
# server serves your latest frontend build without needing to redeploy.
#
# Workflow:
#   Terminal 1 (rebuild on changes): cd web && npm run build
#   Terminal 2 (run server):         cd server && cargo run
#
# Default (when unset): ~/.agent-deck/.process/public  (the installed build)
PUBLIC_DIR=/path/to/agent-deck/server/public

# ── Server ────────────────────────────────────────────────────────────────────

# Port the HTTP server listens on.
# Default: 7474
# PORT=7474

# ── Data directory ────────────────────────────────────────────────────────────

# Root directory for all agent-deck data (database, workspaces, MCP configs, etc.).
# Must be an absolute path if set.
# Default: ~/.agent-deck
# AGENT_DECK_DATA_DIR=/path/to/your/.agent-deck

# ── Logging ───────────────────────────────────────────────────────────────────

# Tracing log level. Use `debug` or `trace` for verbose output during development.
# Default: info
# RUST_LOG=info

# ── Push notifications ────────────────────────────────────────────────────────

# Absolute path to a Firebase service account JSON file.
# Only required if you want FCM-based push notifications.
# FCM_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
